# =====================================================================
# MHouse Models — environment variables
# Copy to .env.local (local development) or set them in your host
# (e.g. Vercel → Project → Settings → Environment Variables).
# =====================================================================

# Public URL of the website, without a trailing slash.
# Used for canonical URLs, sitemap, Open Graph and password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) -------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "anon" / publishable key — safe for the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / secret key — SERVER ONLY. Never expose it or prefix it with NEXT_PUBLIC_.
# Used for: storing contact-form inquiries, the admin setup script.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: email notifications for new inquiries (https://resend.com)
# Without these, inquiries are still stored and visible in Admin → Inquiries.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "MHouse Models <studio@yourdomain.ge>"
CONTACT_FROM_EMAIL=

# --- Optional: private preview ---------------------------------------
# When set, the public website asks for this password before showing anything
# (search engines are blocked too). Delete the value to make the site public.
# The admin panel (/admin) always has its own login and is not affected.
SITE_ACCESS_PASSWORD=
